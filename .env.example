# mySns local dev — Postgres datasource overrides
# Copy to .env and adjust for your environment. application.yaml reads these via ${VAR:default}.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mysns
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Gemini OCR — https://aistudio.google.com → "Get API key" (무료: 1500 req/day, 카드 X)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=30s

# Grafana → Discord ops alerts (paste your Discord channel webhook)
DISCORD_ALERT_WEBHOOK_URL=

# ───────────────────────────────────────────────────────────────
# Docker Compose 배포용 (docker compose up). 위 SPRING_DATASOURCE_* 는
# 컨테이너 배포 시 compose 의 app.environment 가 덮으므로 무시됨.
# ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
APP_PORT=8080
# 필수: 256bit(32자) 이상 강력한 시크릿.
MYSNS_JWT_SECRET=please-generate-a-strong-random-secret-at-least-256-bits-long
# 운영 권장: update(스키마 보존). 완전 초기화는 create-drop.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# 운영에서는 false 권장.
MYSNS_SECURITY_DEVMODE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 저메모리 환경 기본 JVM 옵션.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -XX:+UseContainerSupport
