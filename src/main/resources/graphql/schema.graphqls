scalar DateTime

type Query {
    me: User
    user(id: ID!): User
    userByUsername(username: String!): User
    post(id: ID!): Post
    feed(limit: Int! = 20, offset: Int! = 0): [Post!]!
    bookmarks(limit: Int! = 20, offset: Int! = 0): [Post!]!
    analyzeReceipt(imageUrl: String!): ReceiptAnalysis
}

type ReceiptAnalysis {
    amount: Int
    rawText: String!
    confidence: Float!
}

type Mutation {
    # Auth
    login(input: LoginInput!): AuthPayload!
    register(input: RegisterInput!): AuthPayload!

    # Post
    createPost(input: CreatePostInput!): Post!
    updatePost(id: ID!, input: UpdatePostInput!): Post!
    deletePost(id: ID!): Boolean!

    # Post interactions
    likePost(postId: ID!): Post!
    unlikePost(postId: ID!): Post!
    bookmarkPost(postId: ID!): Post!
    unbookmarkPost(postId: ID!): Post!
    sharePost(postId: ID!): Post!

    # Comment
    addComment(input: CreateCommentInput!): Comment!
    updateComment(id: ID!, input: UpdateCommentInput!): Comment!
    deleteComment(id: ID!): Boolean!
    likeComment(id: ID!): Comment!
    unlikeComment(id: ID!): Comment!

    # Follow
    followUser(id: ID!): User!
    unfollowUser(id: ID!): User!
}

type User {
    id: ID!
    username: String!
    displayName: String!
    bio: String
    avatarUrl: String
    createdAt: DateTime!
    postCount: Int!
    followerCount: Int!
    followingCount: Int!
    viewerIsFollowing: Boolean!
    posts(limit: Int! = 20, offset: Int! = 0): [Post!]!
    bookmarkedPosts(limit: Int! = 20, offset: Int! = 0): [Post!]!
}

type Post {
    id: ID!
    content: String!
    author: User!
    createdAt: DateTime!
    updatedAt: DateTime
    imageUrls: [String!]!
    tag: String
    item: String
    amount: Int
    place: Place
    likeCount: Int!
    commentCount: Int!
    shareCount: Int!
    viewerHasLiked: Boolean!
    viewerHasBookmarked: Boolean!
    previewComment: Comment
    comments(limit: Int! = 20, offset: Int! = 0): [Comment!]!
    likedBy(limit: Int! = 20, offset: Int! = 0): [User!]!
}

# 카카오 Local API 응답 (place_name, x, y, road_address_name, category_group_name, category_group_code, id)
type Place {
    latitude: Float!
    longitude: Float!
    name: String!
    address: String
    externalId: String
    categoryName: String
    categoryCode: String
}

type Comment {
    id: ID!
    content: String!
    author: User!
    post: Post!
    createdAt: DateTime!
    updatedAt: DateTime
    likeCount: Int!
    viewerHasLiked: Boolean!
}

type AuthPayload {
    accessToken: String!
    user: User!
}

input LoginInput {
    username: String!
    password: String!
}

input RegisterInput {
    username: String!
    password: String!
    displayName: String!
}

input CreatePostInput {
    content: String!
    imageUrls: [String!]
    tag: String
    item: String
    amount: Int
    place: PlaceInput
}

input UpdatePostInput {
    content: String
    tag: String
    item: String
    amount: Int
    place: PlaceInput
}

input PlaceInput {
    latitude: Float!
    longitude: Float!
    name: String!
    address: String
    externalId: String
    categoryName: String
    categoryCode: String
}

input CreateCommentInput {
    postId: ID!
    content: String!
}

input UpdateCommentInput {
    content: String!
}
